{
  "name": "impulso-aulas",
  "version": "1.2.0",
  "description": "Contrato das aulas da plataforma Impulso: os tipos dos blocos e as regras que dizem se uma aula e valida.",
  "license": "MIT",
  "author": "Kobe Designer 7, Lda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coder2606/impulso-aulas.git"
  },
  "keywords": ["impulso", "aulas", "blocos", "validacao"],
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "engines": { "node": ">=20.9.0" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verificar": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
